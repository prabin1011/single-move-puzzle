/**
 * Core Philosophy: This ruleset establishes a hybrid security model. User profile data is strictly private and owner-controlled, while landmark and daily puzzle data is publicly readable to allow the game client to fetch puzzle content. Leaderboards are publicly readable but writes are restricted.
 *
 * Data Structure: The data is organized into distinct, top-level collections for private profiles, public game content, and daily challenges. This flat structure prevents complex rule inheritance and simplifies security.
 *
 * Key Security Decisions:
 * - User privacy is paramount; a user can only read or write their own document in the /users collection. Listing all users is disabled to prevent data scraping.
 * - Landmark and Daily Puzzle content is public to read, allowing any client to fetch the data needed to construct puzzles.
 * - Writes to the /landmarks and /dailyPuzzles collections are disabled for clients to protect the integrity of the curated game content.
 * - Daily Leaderboard entries can only be created by the authenticated user for themselves and cannot be updated.
 * - The default security posture is to deny all access unless explicitly granted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    // ===================================

    /**
     * Checks if a user is authenticated via any method (including anonymous).
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the fundamental check for document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profiles Collection
    // ===================================

    /**
     * @description Manages access to user profile documents. Ensures users can only access their own data.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow list: if false; // Prevent enumeration of users
    }

    // Landmarks Collection
    // ===================================

    /**
     * @description Secures the curated landmark content. Allows public reads for the game client but blocks all client-side writes.
     * @path /landmarks/{landmarkId}
     */
    match /landmarks/{landmarkId} {
      allow get, list: if true;
      allow write: if false; // Protect curated content from client modification
    }
    
    // Daily Puzzles Collection
    // ===================================

    /**
     * @description Secures the curated daily puzzles. Allows public reads for game clients.
     * @path /dailyPuzzles/{date}
     */
    match /dailyPuzzles/{date} {
        allow get, list: if true;
        allow write: if false; // Protect curated content
    }

    // Daily Leaderboards Collection
    // ===================================

    /**
     * @description Secures the daily leaderboard entries.
     * @path /dailyLeaderboards/{date}/entries/{userId}
     */
    match /dailyLeaderboards/{date}/entries/{userId} {
        // Anyone can read leaderboard entries
        allow get, list: if true;
        
        // A user can only create an entry for themselves. They cannot update or delete it.
        allow create: if isOwner(userId);
        allow update, delete: if false;
    }


    // DEPRECATED - This collection is no longer in use per the new data model.
    // This is kept temporarily to show the transition, but would be removed.
    match /leaderboardEntries/{leaderboardEntryId} {
        allow read, write: if false;
    }
  }
}
