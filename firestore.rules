
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    // ===================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidLeaderboardEntry(data) {
      return data.keys().hasOnly([
          "userId", "userName", "timeTaken", "hintsUsed", "timestamp", 
          "gameId", "level", "clientDateISO"
        ])
        && data.userId == request.auth.uid
        && data.gameId is string
        && (data.gameId == "landmark" || data.gameId == "math" || data.gameId == "patterns" || data.gameId == "symbol-puzzle" || data.gameId == "word-swap")
        && data.timeTaken is int
        && data.timeTaken > 0
        && data.timeTaken < 3600000 // < 1 hour
        && data.hintsUsed is bool
        && data.userName is string
        && data.userName.size() <= 30
        && (data.level is int || data.level == null)
        && data.clientDateISO is string
        && data.timestamp == request.time;
    }

    // User Profiles Collection
    // ===================================

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow list: if false; 
    }

    // Landmarks Collection
    // ===================================

    match /landmarks/{landmarkId} {
      allow get, list: if true;
      allow write: if false;
    }
    
    // Daily Puzzles Collection
    // ===================================

    match /dailyPuzzles/{date} {
        allow get, list: if true;
        allow write: if false;
    }

    // Daily Leaderboards Collection
    // ===================================

    match /dailyLeaderboards/{date}/entries/{entry} {
      allow get, list: if true;

      // Allow a user to create or overwrite their own entry for a specific game.
      // The document ID is now a composite key: {gameId}_{userId}
      allow write: if isSignedIn()
        && entry.split('_')[1] == request.auth.uid
        && request.resource.data.gameId == entry.split('_')[0]
        && isValidLeaderboardEntry(request.resource.data);
    }

     match /dailyLeaderboards/{date}/stats/{docId} {
        allow get, list: if true;
        allow write: if false;
    }


    // DEPRECATED
    match /leaderboardEntries/{leaderboardEntryId} {
        allow read, write: if false;
    }
  }
}
