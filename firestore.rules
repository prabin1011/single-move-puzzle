/**
 * Core Philosophy: This ruleset establishes a hybrid security model. User profile data is strictly private and owner-controlled, while landmark data is publicly readable to allow the game client to fetch puzzle content.
 *
 * Data Structure: The data is organized into two distinct, top-level collections: /users for private profiles and /landmarks for public game content. This flat structure prevents complex rule inheritance and simplifies security.
 *
 * Key Security Decisions:
 * - User privacy is paramount; a user can only read or write their own document in the /users collection. Listing all users is disabled to prevent data scraping.
 * - Landmark content is public to read, allowing any client to fetch the data needed to construct puzzles.
 * - Writes to the /landmarks collection are disabled for clients to protect the integrity of the curated game content. Admins or server-side processes should be used for content management.
 * - The default security posture is to deny all access unless explicitly granted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    // ===================================

    /**
     * Checks if a user is authenticated via any method (including anonymous).
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the fundamental check for document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profiles Collection
    // ===================================

    /**
     * @description Manages access to user profile documents. Ensures users can only access their own data.
     * @path /users/{userId}
     * @allow (read, write): A user accessing their own document at `/users/USER_UID`.
     * @deny (list): Any attempt to list all user documents, protecting user privacy.
     * @deny (write): A user trying to modify another user's profile.
     */
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow list: if false; // Prevent enumeration of users
    }

    // Landmarks Collection
    // ===================================

    /**
     * @description Secures the curated landmark content. Allows public reads for the game client but blocks all client-side writes.
     * @path /landmarks/{landmarkId}
     * @allow (get, list): Any client can read landmark data to display puzzles.
     * @deny (write): All client-side create, update, and delete operations are blocked to protect content integrity.
     */
    match /landmarks/{landmarkId} {
      allow get, list: if true;
      allow write: if false; // Protect curated content from client modification
    }

    // DEPRECATED - This collection is no longer in use per the new data model.
    // This is kept temporarily to show the transition, but would be removed.
    match /leaderboardEntries/{leaderboardEntryId} {
        allow read, write: if false;
    }
  }
}
